# Copy to keystore.properties (never commit secrets) to sign release APKs with a production key.
# Generate a keystore with:
# keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias astras_release
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=astras_release
keyPassword=CHANGE_ME
